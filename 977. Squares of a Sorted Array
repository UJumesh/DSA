
class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        vector<int> a;
        vector<int> b;
        for(int i=0;i<nums.size(); i++){
            if(nums[i]>=0){
                b.push_back(nums[i]);
            }else{
                a.push_back(nums[i]);
            }
        }
        
            if(a.size() == 0){
                for(int i=0; i<b.size(); i++){
                    b[i] *= b[i];
                   
                }
                 return b;
            }
                if (b.size() == 0){
                    for(int i =0; i<a.size(); i++){
                        a[i] *= a[i];
                       
                    }
                     reverse(a.begin(),a.end());
                        return a;
                    

                    }
                   
                    int id=0;
                    int m =a.size();
                    int n= b.size();
                    vector<int> res(m+n);
                    for(int k =0; k<m; k++){
                        a[k] *= a[k];
                        
                    }
                    reverse(a.begin(),a.end());
    
                    for(int k =0; k<n; k++){
                        b[k] *= b[k];


                    }
                     int i=0;
                    int j=0;
                    while(i<m&& j<n){
                        if(a[i]<b[j]){
                            res[id]=a[i];
                            id++;
                            i++;
                        }else{
                            res[id]=b[j];
                            id++;
                            j++;
                        }
                    }
                    while(i<m){
                        res[id]=a[i];
                        id++;
                        i++;
                    }
                      while(j<n){
                        res[id]=b[j];
                        id++;
                        j++;
                    }


    return res;
            
      
    }
};
